{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openfloor-e2e",
  "main": "../../dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "../../dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "images": { "binding": "IMAGES" },
  "durable_objects": { "bindings": [{ "name": "SESSION_PRESENCE", "class_name": "SessionPresence" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionPresence"] }],
  "r2_buckets": [{ "binding": "PREFLIGHT_LOGS", "bucket_name": "openfloor-e2e-artifacts" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "openfloor-e2e",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "../../drizzle"
  }]
}
