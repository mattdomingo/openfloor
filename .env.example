OPENFLOOR_DEV_USER_ID=local-user
OPENFLOOR_DEV_USER_EMAIL=you@example.com
OPENFLOOR_DEV_USER_NAME=Local Developer
INVITE_SIGNING_SECRET=replace-with-a-long-random-development-secret
GITHUB_APP_ID=replace-with-the-github-app-id
GITHUB_APP_SLUG=replace-with-the-github-app-slug
GITHUB_APP_CLIENT_ID=replace-with-the-github-app-client-id
GITHUB_CLIENT_SECRET=replace-with-the-github-app-client-secret
GITHUB_APP_PRIVATE_KEY=replace-with-the-pem-private-key-using-escaped-newlines
GITHUB_STATE_SECRET=replace-with-a-separate-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-the-github-webhook-secret
RUNTIME_GATEWAY_SECRET=replace-with-a-separate-random-runtime-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-secret
STRIPE_SECRET_KEY=sk_test_replace-with-a-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-a-stripe-webhook-secret
STRIPE_PRO_PRICE_ID=price_replace-with-pro-monthly-price
STRIPE_MAX_PRICE_ID=price_replace-with-max-monthly-price
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace-with-customer-portal-configuration
STRIPE_CHECKOUT_ENABLED=false
EARLY_ACCESS_GATE_ENABLED=false
REPOSITORY_PREVIEW_ENABLED=false
OPENFLOOR_PREVIEW_HOSTNAME=localhost
EARLY_ACCESS_PASSWORD=replace-with-a-secure-beta-passcode
# Optional locally. Production values point to the signed Apps Script web app.
WAITLIST_SHEET_WEBHOOK_URL=
WAITLIST_SHEET_WEBHOOK_SECRET=
# Connect personal provider API keys in Settings; server model keys are never used.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-your-access-application-audience-tag
