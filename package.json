{
  "name": "openfloor",
  "version": "0.1.0",
  "description": "Multiplayer coordination for humans and coding agents on Cloudflare Workers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattdomingo/openfloor.git"
  },
  "bugs": {
    "url": "https://github.com/mattdomingo/openfloor/issues"
  },
  "homepage": "https://github.com/mattdomingo/openfloor#readme",
  "packageManager": "npm@11.19.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config .wrangler.local.jsonc",
    "dev:local": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=.wrangler.local.jsonc WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:migrations && npm run test:worker && npm run test:render && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:migrations": "vitest run --config vitest.worker.config.ts tests/worker/sessions.test.ts tests/worker/floor.test.ts tests/worker/routing.test.ts tests/worker/conflicts.test.ts tests/worker/conflict-selections.test.ts tests/worker/github-webhook.test.ts tests/worker/stripe-billing.test.ts tests/worker/account-merge.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts tests/worker/presence.test.ts tests/worker/run-activity.test.ts tests/worker/credentials.test.ts tests/worker/skills.test.ts tests/worker/mcp-servers.test.ts tests/worker/storage-cleanup.test.ts",
    "test:render": "npm run build && vitest run --config vitest.render.config.ts",
    "test:e2e": "playwright test",
    "demo:record": "npm run build && node scripts/record-website-demo.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "verify:deploy-artifact": "node scripts/verify-deploy-artifact.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.239",
    "@cloudflare/sandbox": "0.12.7",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/codex-sdk": "0.148.0",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.5.0",
    "jose": "^6.2.12",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "stripe": "^22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.151.0"
  },
  "type": "module"
}
