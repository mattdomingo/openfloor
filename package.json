{
  "name": "openfloor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:migrations && npm run test:worker && npm run test:render && npm run test:e2e",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:migrations": "vitest run --config vitest.worker.config.ts tests/worker/sessions.test.ts tests/worker/floor.test.ts tests/worker/routing.test.ts tests/worker/github-webhook.test.ts tests/worker/account-merge.test.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts tests/worker/presence.test.ts tests/worker/run-activity.test.ts tests/worker/credentials.test.ts tests/worker/skills.test.ts tests/worker/mcp-servers.test.ts",
    "test:render": "npm run build && vitest run --config vitest.render.config.ts",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.239",
    "@cloudflare/sandbox": "0.12.7",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.148.0",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
