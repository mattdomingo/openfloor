{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openfloor",
	// Newest date the pinned wrangler (4.92.0) ships a runtime for. A later date
	// is rejected outright rather than ignored, so this moves with wrangler.
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	// Daily retention sweep: purge sessions ended more than 30 days ago
	// (ENDED_SESSION_RETENTION_MS in db/sessions.ts).
	"triggers": {
		"crons": [
			"0 4 * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_PRESENCE",
				"class_name": "SessionPresence"
			},
			{
				"name": "SESSION_ROUTER",
				"class_name": "SessionRouter"
			},
			{
				"name": "SANDBOX",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SessionPresence"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"SessionRouter"
			]
		}
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile.sandbox",
			"instance_type": "lite",
			"max_instances": 5
		}
	],
	"workflows": [
		{
			"name": "openfloor-repository-preflight",
			"binding": "REPOSITORY_PREFLIGHT",
			"class_name": "RepositoryPreflightWorkflow"
		},
		{
			"name": "openfloor-agent-run",
			"binding": "AGENT_RUN_WORKFLOW",
			"class_name": "AgentRunWorkflow"
		}
	],
	"vars": {
		"OPENFLOOR_RUNTIME_ORIGIN": "https://opnflr.com/app",
		"PREFLIGHT_ENABLED": "true",
		"AGENT_RUN_ENABLED": "true"
	},
	"r2_buckets": [
		{
			"binding": "PREFLIGHT_LOGS",
			"bucket_name": "openfloor-preflight-logs"
		},
		{
			"binding": "USER_AVATARS",
			"bucket_name": "openfloor-user-avatars"
		}
	],
	// opnflr.com is a Cloudflare Pages project (the marketing site). A Workers
	// route is more specific than the Pages custom domain, so these two patterns
	// peel /app off the site and leave every other path with Pages.
	//
	// Both patterns are needed: "/app/*" alone does not match a bare "/app".
	// Neither is a wildcard on "/app*", which would also swallow "/approach".
	// next/font emits its woff2 URLs without the basePath, so those requests
	// arrive at the apex and would hit Pages. The marketing site addresses its
	// own hashed files under /dist, never /assets, so claiming this one prefix
	// costs it nothing.
	//
	// "/app" and "/app/*" is the precise pair, but a pattern with no wildcard has
	// to match the whole URL including the query string, so opnflr.com/app?utm=x
	// fell through to Pages and served the marketing page. Query strings cannot
	// go in a pattern either (the API rejects them), so the prefix wildcard is
	// the only form that covers them. It also matches /approach and anything
	// else starting with "app", which test.mjs in the site repo now guards.
	"routes": [
		{
			"pattern": "opnflr.com/app*",
			"zone_name": "opnflr.com"
		},
		{
			"pattern": "opnflr.com/assets/_vinext_fonts/*",
			"zone_name": "opnflr.com"
		}
	],
	// not_found_handling "none" matters with basePath: a request for
	// /app/assets/x.js has no file at that path (Vite writes assets/x.js and only
	// rewrites the URL), so the asset server must fall through to the Worker,
	// which strips /app and re-resolves through the ASSETS binding.
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openfloor-production",
			"database_id": "1e5059bf-1f7b-4be8-8ea4-c424a191070a",
			"migrations_dir": "drizzle"
		}
	]
}
