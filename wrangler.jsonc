{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openfloor",
	// Newest date the pinned wrangler (4.92.0) ships a runtime for. A later date
	// is rejected outright rather than ignored, so this moves with wrangler.
	"compatibility_date": "2026-05-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./worker/index.ts",
	// Daily retention sweep at 04:00: purge sessions ended more than 30 days
	// ago (ENDED_SESSION_RETENTION_MS in db/sessions.ts). Every 10 minutes:
	// destroy warm-pool sandboxes idle past their TTL (db/sandbox-pool.ts).
	"triggers": {
		"crons": [
			"0 4 * * *",
			"*/10 * * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SESSION_PRESENCE",
				"class_name": "SessionPresence"
			},
			{
				"name": "SESSION_ROUTER",
				"class_name": "SessionRouter"
			},
			{
				"name": "SANDBOX",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SessionPresence"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"Sandbox"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"SessionRouter"
			]
		}
	],
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile.sandbox",
			// standard-2 (1 vCPU, 6 GiB): tar extraction, git passes, npm ci, and
			// user checks were CPU-starved at lite's 1/16 vCPU, and 256 MiB OOMs
			// real builds. Each run needs two containers (run + publisher), so the
			// cap covers 2 × GLOBAL_RUN_BUDGET, three preview leases, and
			// cleanup-lag headroom.
			"instance_type": "standard-2",
			"max_instances": 15
		}
	],
	"workflows": [
		{
			"name": "openfloor-repository-preflight",
			"binding": "REPOSITORY_PREFLIGHT",
			"class_name": "RepositoryPreflightWorkflow"
		},
		{
			"name": "openfloor-agent-run",
			"binding": "AGENT_RUN_WORKFLOW",
			"class_name": "AgentRunWorkflow"
		},
		{
			"name": "openfloor-repository-preview",
			"binding": "REPOSITORY_PREVIEW",
			"class_name": "RepositoryPreviewWorkflow"
		}
	],
	"vars": {
		// RPC transport is required for sandbox.writeFile() calls that pass a
		// ReadableStream body (session shared-file copies in agent-run-workflow.ts) —
		// HTTP/WebSocket transports don't support writeFileStream.
		"SANDBOX_TRANSPORT": "rpc",
		"OPENFLOOR_RUNTIME_ORIGIN": "https://app.opnflr.com",
		"OPENFLOOR_PREVIEW_HOSTNAME": "preview.opnflr.com",
		"REPOSITORY_PREVIEW_ENABLED": "false",
		"PREFLIGHT_ENABLED": "false",
		// Global beta execution is enabled after Sandbox image v9 deployed with
		// the adversarially tested provider/workspace uid boundary. Provider-level
		// gates below still restrict unaccepted providers independently.
		"AGENT_RUN_ENABLED": "true",
		// Checkout rollout gate: enabled and selling. The docs/stripe-billing.md
		// acceptance flow passed against production on test-mode keys, and the
		// Worker's five STRIPE_* secrets have since been swapped to live mode —
		// prices, Portal configuration, and webhook endpoint are all live-mode
		// objects, distinct from the test-mode set they replaced.
		"STRIPE_CHECKOUT_ENABLED": "true",
		// Claude-runner rollout gate: enabled now that the Agent SDK image,
		// anthropic gateway, and a resolvable Anthropic credential are live.
		"CLAUDE_RUN_ENABLED": "true",
		// Kimi rollout gate: enabled — the kimi gateway route is deployed and
		// MOONSHOT_API_KEY is set as the server fallback credential.
		"KIMI_RUN_ENABLED": "true",
		// Gemini rollout gate: enabled — the v3 image (Gemini CLI + runner),
		// gemini gateway route, and the GEMINI_API_KEY fallback are live.
		"GEMINI_RUN_ENABLED": "true",
		// GLM (Z.ai) rollout gate: keep false until the deploy carrying the
		// glm gateway route is live, a credential resolves (ZAI_API_KEY or an
		// owner-connected key), and the per-provider acceptance runbook
		// passes. No image bump — GLM reuses the Claude runner unchanged.
		"GLM_RUN_ENABLED": "false",
		// Qwen (Alibaba Cloud) and DeepSeek rollout gates: keep false until the
		// deploy carrying the v6 image (Qwen Code CLI + runner), each gateway
		// route, and a resolvable credential (DASHSCOPE_API_KEY /
		// DEEPSEEK_API_KEY or an owner-connected key) are live and the
		// per-provider acceptance runbook passes — Spikes Q2/D1 first.
		"QWEN_RUN_ENABLED": "false",
		"DEEPSEEK_RUN_ENABLED": "false",
		// Production early-access enforcement is enabled after the disabled-mode
		// deployment, Sheet delivery, and WAF acceptance checks passed.
		// Rollback is "false"; grants, revocations, and waitlist rows remain intact.
		"EARLY_ACCESS_GATE_ENABLED": "true",
		// Custom sign-in page rollout gate: on per explicit ship decision
		// 2026-08-25, ahead of the live production Access verification
		// (real Google + real email-code sign-in, plus the upstream-
		// extraction fallback drill) called for in the original decision log
		// entry — that check has NOT been run against production. Verify
		// immediately after deploy; if sign-in breaks, flip this back to
		// "false" first (accessSignInPath() then points straight at the
		// Access-protected path, i.e. pre-2026-08-25 behavior) and diagnose
		// after.
		"ACCESS_CUSTOM_LOGIN_ENABLED": "true"

	},
	"r2_buckets": [
		{
			"binding": "PREFLIGHT_LOGS",
			"bucket_name": "openfloor-preflight-logs"
		},
		{
			"binding": "USER_AVATARS",
			"bucket_name": "openfloor-user-avatars"
		}
	],
	// The app now owns its own subdomain, a sibling to the opnflr.com marketing
	// site (a separate Cloudflare Pages project) rather than a path nested under
	// it. custom_domain claims the whole hostname for this Worker and has
	// Cloudflare manage the DNS record itself, so there's nothing to reserve or
	// carve out of the marketing site's routing the way /app* was.
	"routes": [
		{
			"pattern": "app.opnflr.com",
			"custom_domain": true
		}
	],
	// not_found_handling "none" matters with basePath: a request for
	// /app/assets/x.js has no file at that path (Vite writes assets/x.js and only
	// rewrites the URL), so the asset server must fall through to the Worker,
	// which strips /app and re-resolves through the ASSETS binding.
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openfloor-production",
			"database_id": "1e5059bf-1f7b-4be8-8ea4-c424a191070a",
			"migrations_dir": "drizzle"
		}
	],
	// The permanent release branch deploys through this named environment. Every
	// non-inherited/stateful binding is repeated deliberately so a development
	// deploy cannot read or mutate production state. Runtime secrets are also
	// environment-scoped and are configured separately in Cloudflare.
	"env": {
		"development": {
			"name": "openfloor-development",
			"triggers": {
				"crons": [
					"0 4 * * *",
					"*/10 * * * *"
				]
			},
			"durable_objects": {
				"bindings": [
					{
						"name": "SESSION_PRESENCE",
						"class_name": "SessionPresence"
					},
					{
						"name": "SESSION_ROUTER",
						"class_name": "SessionRouter"
					},
					{
						"name": "SANDBOX",
						"class_name": "Sandbox"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": [
						"SessionPresence"
					]
				},
				{
					"tag": "v2",
					"new_sqlite_classes": [
						"Sandbox"
					]
				},
				{
					"tag": "v3",
					"new_sqlite_classes": [
						"SessionRouter"
					]
				}
			],
			"containers": [
				{
					"class_name": "Sandbox",
					"image": "./Dockerfile.sandbox",
					"instance_type": "standard-2",
					"max_instances": 15
				}
			],
			"workflows": [
				{
					"name": "openfloor-development-repository-preflight",
					"binding": "REPOSITORY_PREFLIGHT",
					"class_name": "RepositoryPreflightWorkflow"
				},
				{
					"name": "openfloor-development-agent-run",
					"binding": "AGENT_RUN_WORKFLOW",
					"class_name": "AgentRunWorkflow"
				},
				{
					"name": "openfloor-development-repository-preview",
					"binding": "REPOSITORY_PREVIEW",
					"class_name": "RepositoryPreviewWorkflow"
				}
			],
			"vars": {
				"SANDBOX_TRANSPORT": "rpc",
				"OPENFLOOR_RUNTIME_ORIGIN": "https://dev.app.opnflr.com",
				"OPENFLOOR_PREVIEW_HOSTNAME": "preview.dev.opnflr.com",
				"REPOSITORY_PREVIEW_ENABLED": "false",
				"PREFLIGHT_ENABLED": "false",
				// Development execution is enabled after the isolated Access policy,
				// GitHub App, runtime secrets, and first deployment were accepted.
				// Provider credentials remain user-owned unless separate development
				// fallback secrets are deliberately configured.
				"AGENT_RUN_ENABLED": "true",
				// Never accept production payments from the development deployment.
				// A later test-mode Stripe rollout may deliberately enable this.
				"STRIPE_CHECKOUT_ENABLED": "false",
				"CLAUDE_RUN_ENABLED": "true",
				"KIMI_RUN_ENABLED": "true",
				"GEMINI_RUN_ENABLED": "true",
				"GLM_RUN_ENABLED": "false",
				"QWEN_RUN_ENABLED": "false",
				"DEEPSEEK_RUN_ENABLED": "false",
				// Access still authenticates the development hostname; the separate
				// D1 admission gate starts open so setup does not copy production grants.
				"EARLY_ACCESS_GATE_ENABLED": "false",
				"ACCESS_CUSTOM_LOGIN_ENABLED": "true"
			},
			"r2_buckets": [
				{
					"binding": "PREFLIGHT_LOGS",
					"bucket_name": "openfloor-development-preflight-logs"
				},
				{
					"binding": "USER_AVATARS",
					"bucket_name": "openfloor-development-user-avatars"
				}
			],
			"routes": [
				{
					"pattern": "dev.app.opnflr.com",
					"custom_domain": true
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "openfloor-development",
					"database_id": "fe7e3046-8cd8-4aae-a226-87534b2d9f15",
					"migrations_dir": "drizzle"
				}
			]
		}
	}
}
