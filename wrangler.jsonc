{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfloor",
  // Newest date the pinned wrangler (4.92.0) ships a runtime for. A later date
  // is rejected outright rather than ignored, so this moves with wrangler.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",

  // opnflr.com is a Cloudflare Pages project (the marketing site). A Workers
  // route is more specific than the Pages custom domain, so these two patterns
  // peel /app off the site and leave every other path with Pages.
  //
  // Both patterns are needed: "/app/*" alone does not match a bare "/app".
  // Neither is a wildcard on "/app*", which would also swallow "/approach".
  // next/font emits its woff2 URLs without the basePath, so those requests
  // arrive at the apex and would hit Pages. The marketing site addresses its
  // own hashed files under /dist, never /assets, so claiming this one prefix
  // costs it nothing.
  "routes": [
    { "pattern": "opnflr.com/app", "zone_name": "opnflr.com" },
    { "pattern": "opnflr.com/app/*", "zone_name": "opnflr.com" },
    { "pattern": "opnflr.com/assets/_vinext_fonts/*", "zone_name": "opnflr.com" }
  ],

  // not_found_handling "none" matters with basePath: a request for
  // /app/assets/x.js has no file at that path (Vite writes assets/x.js and only
  // rewrites the URL), so the asset server must fall through to the Worker,
  // which strips /app and re-resolves through the ASSETS binding.
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": { "binding": "IMAGES" }
}
